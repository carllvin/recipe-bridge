# Tandoor Helper configuration
# Copy to .env (`cp .env.example .env`) and fill in the required values.
# Commented-out lines show the default that applies when the line is left out.

# ---------- Required ----------

# AI provider for recipe extraction: anthropic (Claude) | openai (ChatGPT) | gemini (Google)
AI_PROVIDER=anthropic

# API key for the provider chosen above (the other two can stay empty)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Your Tandoor instance, WITHOUT a trailing slash, e.g. http://192.168.1.100:8080
TANDOOR_URL=
# Tandoor API token: user menu -> settings -> API -> "create new token"
TANDOOR_TOKEN=

# Password for the web interface (empty = no password). Recommended as soon
# as the helper is reachable from outside your home network - e.g. via HTTPS
# for the phone's share menu. Each device signs in once and stays signed in;
# changing the password signs every device out.
# APP_PASSWORD=

# ---------- Notifications (optional) ----------

# Push messages to your phone when an import from the phone / the watched
# folder is ready, automatic runs prepared suggestions, or the monthly AI
# budget reaches 80 % / is used up. ntfy: install the ntfy app, subscribe to
# a topic with a hard-to-guess name and put its address here.
# NOTIFY_NTFY_URL=https://ntfy.sh/my-secret-kitchen-topic
# NOTIFY_NTFY_TOKEN=          # only for a protected (self-hosted) topic
# Telegram: create a bot with @BotFather, send it a message, then put the
# bot token and your chat id here.
# NOTIFY_TELEGRAM_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
# Public address of the helper - notifications link to it
# APP_URL=https://helper.example.com

# ---------- AI models ----------

# CLAUDE_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.5-flash

# Cheaper model for the maintenance tools (🔧 Tools and backend/scripts):
# matching ingredients/units/tags, tag and season suggestions, plurals,
# nutrition. Cookbook extraction and recipe translation keep the model above.
# Empty = use the main model for the tools too. For OpenAI/Gemini there's no
# default - set e.g. a "mini" / "flash-lite" model of your choice.
# CLAUDE_TOOLS_MODEL=claude-haiku-4-5-20251001
# OPENAI_TOOLS_MODEL=
# GEMINI_TOOLS_MODEL=

# ---------- Output ----------

# Language for extracted/translated recipes AND the web UI
# (full UI translations: Deutsch, English, Français, Italiano, Español)
# OUTPUT_LANGUAGE=English
# Convert cups/oz/lb/°F/inch to g/ml/°C/cm
# CONVERT_TO_METRIC=true
# Check recipe titles against existing Tandoor recipes before import
# CHECK_DUPLICATES=true
# Prefer reusing existing Tandoor tags when the AI generates tags
# REUSE_EXISTING_TAGS=true
# Free-text rules appended to the extraction prompt; they take precedence over
# the built-in guidance, e.g.:
# CUSTOM_INSTRUCTIONS="Always add the tag 'family-recipe'. If servings aren't stated, assume 4."
# EXPERIMENTAL: align chunk boundaries to the PDF's bookmarks/TOC
# (has caused some PDFs to yield 0 recipes - leave off unless needed)
# TOC_AWARE_CHUNKING=false

# ---------- OCR (scanned PDF pages and uploaded photos) ----------

# Tesseract language code(s), '+'-joined, e.g. eng+deu (installed: eng, deu, fra, ita, spa)
# OCR_LANGUAGES=eng
# Pages with less extracted text than this are treated as scans and OCR'd
# OCR_MIN_CHARS_PER_PAGE=20
# Render resolution for OCR - higher is more accurate but slower
# OCR_DPI=300
# Deskew + auto-crop + contrast enhancement before OCR
# OCR_PREPROCESS_ENABLED=true
# Detect two-page spreads in one image and OCR each half separately
# OCR_DOUBLE_PAGE_DETECTION=true
# Width/height ratio above which an image counts as a double-page spread
# OCR_DOUBLE_PAGE_ASPECT_THRESHOLD=1.3
# OCR every page even if it has a text layer (use if extracted text looks garbled)
# FORCE_OCR=false

# ---------- AI image generation (for recipes without a photo) ----------

# Off by default - generating images costs money per recipe
# IMAGE_GEN_ENABLED=false
# openai | gemini (Claude has no image generation API)
# IMAGE_GEN_PROVIDER=openai
# OPENAI_IMAGE_MODEL=gpt-image-1
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Extra instructions appended to the image-generation prompt
# IMAGE_GEN_CUSTOM_INSTRUCTIONS=

# ---------- Housekeeping ----------

# Delete jobs (and their uploaded files) older than this many hours
# JOB_RETENTION_HOURS=48
# Run "Process new recipes" automatically every N hours (0 = off). Each run
# translates new recipes right away; all other suggestions wait in
# 🔧 Tools for you to review. Uses AI tokens only when there are new recipes.
# AUTO_PROCESS_INTERVAL_HOURS=0

# Watched folder (empty = off): PDFs, photos and documents put into this
# folder are imported on their own and wait in the review inbox under
# "New imports". Each file is one import, a subfolder of photos is one photo
# import. Imported files move to processed/, unusable ones to failed/.
# Mount the folder into the container (see docker-compose.yml), e.g.
# WATCH_DIR=/app/import
# How often the folder is checked, in seconds
# WATCH_INTERVAL_SECONDS=30

# Time zone of the container - the automatic maintenance (Maintain ->
# Automation & budget) runs at this local time, and the monthly AI budget
# starts on the 1st in this zone.
# TZ=Europe/Berlin
# Maximum upload size in MB
# MAX_UPLOAD_MB=100
