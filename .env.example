# Recipe Bridge - copy to .env next to docker-compose.yml and fill in the top part.
# Every other setting is optional: docs/configuration.md lists them all.

# ---------- Required ----------

# anthropic | openai | gemini | compatible (Ollama, LM Studio, OpenRouter ...)
AI_PROVIDER=anthropic
# The key for that provider (the others stay empty)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Tandoor: address without a trailing slash, and an API token
# (Tandoor: user menu -> Settings -> API -> create new token)
TANDOOR_URL=
TANDOOR_TOKEN=
# Or Mealie instead (Mealie: user profile -> API tokens)
# RECIPE_MANAGER=mealie
# MEALIE_URL=
# MEALIE_TOKEN=

# Language of the recipes and the app (Deutsch, English, Français, Italiano, Español ...)
OUTPUT_LANGUAGE=English

# ---------- Often used (optional) ----------

# Your time zone - automatic runs and the monthly budget follow it (default UTC)
# TZ=Europe/Berlin
# Password for the web interface - set it once the app is reachable from outside
# APP_PASSWORD=
# false: keep every recipe in the language it was written in
# TRANSLATE_RECIPES=true
# Watched folder: files put there are imported on their own (mount it, see docker-compose.yml)
# WATCH_DIR=/app/import
# Push notifications via ntfy (or NOTIFY_TELEGRAM_TOKEN + NOTIFY_TELEGRAM_CHAT_ID)
# NOTIFY_NTFY_URL=https://ntfy.sh/my-secret-kitchen-topic
# Photos for recipes without one, by the image AI (openai | gemini, costs per image)
# IMAGE_GEN_ENABLED=false
# OCR languages for scans and photos, e.g. eng+deu
# OCR_LANGUAGES=eng
# A local model (AI_PROVIDER=compatible)
# COMPATIBLE_BASE_URL=http://ollama:11434/v1
# COMPATIBLE_MODEL=qwen2.5:14b
